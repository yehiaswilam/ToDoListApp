@model TodoItem
@{
    ViewData["Title"] = "Edit Task";
}

<h2>Edit Task</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="mb-2">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-2">
        <label asp-for="Deadline" class="form-label"></label>
        <input asp-for="Deadline" type="datetime-local" class="form-control" />
        <span asp-validation-for="Deadline" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">File</label>
        @if (!string.IsNullOrEmpty(Model.OriginalFileName))
        {
            <div class="small text-muted mb-1">Current: @Model.OriginalFileName (اختار ملف جديد لو عايز تستبدله)</div>
        }
        <input type="file" name="file" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Back</a>
</form>
